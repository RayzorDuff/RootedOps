# =========
# Postgres: SignatureGate core
# =========
SIG_DB_HOST=signaturegate-postgres
SIG_DB_PORT=5432
SIG_DB_NAME=signaturegate
SIG_DB_USER=signaturegate
SIG_DB_PASSWORD=change_me

# =========
# Postgres: MushroomProcess bridge (optional)
# - Use this as either:
#   (A) a readonly replica of MushroomProcess DB; OR
#   (B) a small cache of selected MushroomProcess fields (lot_id, strain, regulated flag, etc.)
# =========
MP_BRIDGE_DB_HOST=mushroomprocess-bridge-postgres
MP_BRIDGE_DB_PORT=5432
MP_BRIDGE_DB_NAME=mushroomprocess_bridge
MP_BRIDGE_DB_USER=mushroomprocess_bridge
MP_BRIDGE_DB_PASSWORD=change_me

# =========
# NocoDB
# =========
NC_PUBLIC_URL=https://your.nginxserver.name
# No secure attachments
NC_SECURE_ATTACHMENTS=false
# Or - one year expiry on secure attachments
#NC_SECURE_ATTACHMENTS=false
NC_ATTACHMENT_EXPIRE_SECONDS=31536000
NC_DB_HOST=nocodb-meta-postgres
NC_DB_PORT=5432
NC_DB_NAME=nocodb_meta
NC_DB_USER=nocodb
NC_DB_PASSWORD=change_me
NC_AUTH_JWT_SECRET=change_me
NC_MAX_ATTACHMENT_FIELD_SIZE=1073741824
NC_ATTACHMENT_FIELD_SIZE=104857600
NC_MAX_ATTACHMENTS_ALLOWED=20
NC_ALLOW_LOCAL_EXTERNAL_DBS=true

# =========
# n8n
# =========
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me
N8N_ENCRYPTION_KEY=change_me
N8N_SECURE_COOKIE=true
N8N_HOST=n8n.yourdomain.com
N8N_PORT=5678
N8N_PROTOCOL=https
# This is set to 1 when nginx is enabled
N8N_PROXY_HOPS=1
WEBHOOK_URL=https://n8n.yourdomain.com/
# Tokens generaed elsewhere and used by n8n
DOCUMENSO_API_TOKEN=api_yourgeneratedtoken
NOCODB_API_TOKEN=yourgeneratedtoken
# Airtable is a temporary connection point for MushroomProcess
# To be replaced with the above NocoDB
AIRTABLE_BASE_ID=appx_airtablebaseid
AIRTABLE_API_TOKEN=yourgeneratedtoken
# These are the URL-style names
AIRTABLE_PRODUCTS_TABLE_ID=tbl51zhGGDuaL2Sm4
AIRTABLE_LOCATIONS_TABLE_ID=tbl2QYDX1lLDyrpcm
AIRTABLE_ECOMMERCE_ORDERS_TABLE_ID=tblWXZlk8KB29P312
# Givebutter sends a secret in the signature header
GIVEBUTTER_SIGNING_SECRET=yourgivebutterwebhooksecret
# ERPNext requires API key and secret for access
ERPNEXT_API_KEY=yourerpnextapikey
ERPNEXT_API_SECRET=yourerpnextapisecret
# Ecwid updates via API
ECWID_STORE_ID=your_ecwid_store_id
ECWID_SECRET_TOKEN=secret_xxxxx
ECWID_CLIENT_SECRET=your_ecwid_app_client_secret
# Optional but recommended if you ask Ecwid to send a custom webhook header:
ECWID_WEBHOOK_HEADER_NAME=My-Custom-Validation-Key
ECWID_WEBHOOK_HEADER_VALUE=your_static_random_value
# Clover API access
CLOVER_API_BASE_URL=https://api.clover.com
CLOVER_MERCHANT_ID=your_clover_merchant_id
CLOVER_ACCESS_TOKEN=your_clover_access_token
CLOVER_MATCH_WINDOW_MINUTES=15
CLOVER_PENDING_GRACE_MINUTES=10
# For sending email reports
REPORT_FROM_EMAIL=you@yourdomain.com
REPORT_TO_EMAIL=you@yourdomain.com
REPORT_TIMEZONE=America/Denver
BUSINESS_NAME="My Business"
REGULATED_BUSINESS_NAME="Regulated Business"

# =========
# Appsmith
# =========
APPSMITH_ENCRYPTION_PASSWORD=change_me
APPSMITH_ENCRYPTION_SALT=change_me
APPSMITH_SUPERVISOR_PASSWORD=change_me
APPSMITH_SERVER_TIMEOUT=180
APPSMITH_CODEC_SIZE=50

# =========
# Documenso (self-hosted e-sign)
# =========
# Public URL you will route via NGINX (see nginx/documenso.conf)
DOCUMENSO_PUBLIC_URL=https://documenso.yourdomain.com
DOCUMENSO_PRIVATE_JOBS_PROVIDER=local
DOCUMENSO_PRIVATE_INTERNAL_WEBAPP_URL=http://documenso:3000

# Generate random secrets (example: openssl rand -hex 32)
DOCUMENSO_NEXTAUTH_SECRET=change_me
DOCUMENSO_ENCRYPTION_KEY=change_me
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=change_me

# Signing certificate passphrase (required)
DOCUMENSO_SIGNING_PASSPHRASE=change_me

# Postgres (Documenso)
DOCUMENSO_DB_HOST=documenso-postgres
DOCUMENSO_DB_PORT=5432
DOCUMENSO_DB_NAME=documenso
DOCUMENSO_DB_USER=documenso
DOCUMENSO_DB_PASSWORD=change_me

# SMTP (Documenso) - required to email signing links
DOCUMENSO_SMTP_TRANSPORT=smtp-auth
DOCUMENSO_SMTP_HOST=smtp.yourdomain.com
DOCUMENSO_SMTP_PORT=587
DOCUMENSO_SMTP_USERNAME=no-reply@yourdomain.com
DOCUMENSO_SMTP_PASSWORD=change_me
DOCUMENSO_PRIVATE_SMTP_SECURE=false
DOCUMENSO_PRIVATE_SMTP_UNSAFE_IGNORE_TLS=false
DOCUMENSO_SMTP_FROM_NAME=Your Company
DOCUMENSO_SMTP_FROM_ADDRESS=no-reply@yourdomain.com

# =========
# ERPNext / Frappe HR
# - ERPNext handles accounting, purchasing, sales, and multi-company books.
# - Payroll, leave, attendance, and broader HR workflows are provided by the HRMS app.
# =========
ERPNEXT_IMAGE_TAG=version-16
ERPNEXT_MARIADB_VERSION=11.4
ERPNEXT_REDIS_VERSION=7.2-alpine
ERPNEXT_DB_HOST=erpnext-db
ERPNEXT_DB_PORT=3306
ERPNEXT_DB_ROOT_PASSWORD=change_me
ERPNEXT_REDIS_CACHE_HOST=erpnext-redis-cache
ERPNEXT_REDIS_CACHE_PORT=6379
ERPNEXT_REDIS_QUEUE_HOST=erpnext-redis-queue
ERPNEXT_REDIS_QUEUE_PORT=6379
ERPNEXT_SOCKETIO_PORT=9000
ERPNEXT_HTTP_PORT=8086
ERPNEXT_SITE_NAME=erp.yourdomain.com
ERPNEXT_PUBLIC_URL=https://erp.yourdomain.com
ERPNEXT_ADMIN_PASSWORD=change_me
ERPNEXT_HRMS_BRANCH=version-16
ERPNEXT_ESS_BRANCH=version-16


# =========
# Minecraft Bedrock BedWars (official Bedrock Dedicated Server)
# =========
# DNS: point minecraft.yourdomain.com to this host.
# Bedrock clients connect to minecraft.yourdomain.com on this UDP port.
MINECRAFT_BEDWARS_HOST=minecraft.yourdomain.com
MINECRAFT_BEDWARS_PORT=19132
MINECRAFT_BEDROCK_IMAGE_TAG=latest
MINECRAFT_BEDWARS_SERVER_NAME=Rooted BedWars
MINECRAFT_BEDWARS_LEVEL_NAME=bedwars_minigame
MINECRAFT_BEDWARS_GAMEMODE=adventure
MINECRAFT_BEDWARS_DIFFICULTY=normal
MINECRAFT_BEDWARS_MAX_PLAYERS=8
MINECRAFT_BEDWARS_ONLINE_MODE=true
MINECRAFT_BEDWARS_ALLOW_CHEATS=true
# Private invite-only server. Add Bedrock gamertags separated by commas after the first join/logs confirm names.
MINECRAFT_BEDWARS_ALLOW_LIST=true
MINECRAFT_BEDWARS_ALLOW_LIST_USERS=PlayerOneName,PlayerTwoName

# Backups
LOCAL_STAGING_PARENT=/var/tmp/rootedops-backups
RCLONE_REMOTE=rootedops-gdrive
REMOTE_BACKUP_ROOT=rootedops-gdrive:RootedOpsBackups
BACKUP_PREFIX=rootedops
KEEP_DAILY_DAYS=7
# Minecraft Bedrock data is a bind mount, not a Docker volume.
# The backup script stops minecraft-bedwars during this archive by default to avoid copying an active LevelDB world.
MINECRAFT_BEDROCK_DATA_PATH=./minecraft/bedrock
MINECRAFT_BACKUP_STOP_CONTAINER=true
