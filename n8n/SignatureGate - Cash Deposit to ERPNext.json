        "query": "SELECT *\nFROM public.complete_cash_deposit_erp_sync(\n  '{{ String($json.deposit_batch_id || '').replace(/'/g, \"''\") }}'::uuid,\n  {{ $json.success === true ? 'true' : 'false' }}::boolean,\n  NULLIF('{{ String($json.erp_doctype || '').replace(/'/g, \"''\") }}', ''),\n  NULLIF('{{ String($json.erp_name || '').replace(/'/g, \"''\") }}', ''),\n  NULLIF('{{ String($json.error || '').replace(/'/g, \"''\") }}', ''),\n  '{{ JSON.stringify($json.response || {}).replace(/'/g, \"''\") }}'::jsonb\n);",
        "options": {}
      },
