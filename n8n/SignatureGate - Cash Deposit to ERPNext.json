        "jsCode": "const source = $items('PG - Begin ERP Sync')[0]?.json || {};\nconst body = $json.body ?? $json;\nconst result = body?.message ?? body;\nconst statusCode = $json.statusCode ?? null;\nconst httpFailed = !!$json.error || (statusCode !== null && Number(statusCode) >= 400);\nconst success = !httpFailed && result?.ok === true;\nconst error = success ? null : String($json.error?.message || result?.error || body?.exception || body?.message || 'RootedOps ERP synchronization failed.');\nreturn [{ json: { deposit_batch_id: source.deposit_batch_id, source_key: source.source_key, success, erp_doctype: result?.erp_doctype || '', erp_name: result?.erp_name || '', error, response: result || body || {} } }];"
