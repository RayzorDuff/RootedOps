        "jsCode": "const body = $json.body ?? $json;\nconst depositBatchId = String(body.deposit_batch_id || '').trim();\nconst mode = String(body.mode || 'production').trim().toLowerCase();\n\nif (!/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(depositBatchId)) {\n  throw new Error('A valid deposit_batch_id UUID is required.');\n}\nif (!['production', 'test'].includes(mode)) throw new Error('mode must be production or test.');\nreturn [{ json: { deposit_batch_id: depositBatchId, mode } }];"
