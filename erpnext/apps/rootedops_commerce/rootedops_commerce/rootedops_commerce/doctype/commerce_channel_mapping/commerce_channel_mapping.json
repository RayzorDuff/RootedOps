{
  "name": "Commerce Channel Mapping",
  "doctype": "DocType",
  "module": "RootedOps Commerce",
  "engine": "InnoDB",
  "track_changes": 1,
  "field_order": [
    "item",
    "provider",
    "site_key",
    "external_product_id",
    "external_variation_id",
    "external_sku",
    "mushroomprocess_ecommerce_id",
    "sync_enabled",
    "sync_status",
    "last_synced",
    "last_error"
  ],
  "fields": [
    {
      "fieldname": "item",
      "label": "Item",
      "fieldtype": "Link",
      "options": "Item",
      "reqd": 1
    },
    {
      "fieldname": "provider",
      "label": "Provider",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "site_key",
      "label": "Site Key",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "external_product_id",
      "label": "External Product Id",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "external_variation_id",
      "label": "External Variation Id",
      "fieldtype": "Data"
    },
    {
      "fieldname": "external_sku",
      "label": "External Sku",
      "fieldtype": "Data"
    },
    {
      "fieldname": "mushroomprocess_ecommerce_id",
      "label": "Mushroomprocess Ecommerce Id",
      "fieldtype": "Data"
    },
    {
      "fieldname": "sync_enabled",
      "label": "Sync Enabled",
      "fieldtype": "Check",
      "default": 0
    },
    {
      "fieldname": "sync_status",
      "label": "Sync Status",
      "fieldtype": "Select",
      "options": "Pending\nSynced\nError",
      "default": "Pending"
    },
    {
      "fieldname": "last_synced",
      "label": "Last Synced",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "last_error",
      "label": "Last Error",
      "fieldtype": "Small Text"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "export": 1
    },
    {
      "role": "Sales Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "export": 1
    },
    {
      "role": "Sales User",
      "read": 1
    }
  ]
}
