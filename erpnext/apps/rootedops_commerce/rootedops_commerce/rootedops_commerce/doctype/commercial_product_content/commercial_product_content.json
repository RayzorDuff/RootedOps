{
  "name": "Commercial Product Content",
  "doctype": "DocType",
  "module": "RootedOps Commerce",
  "engine": "InnoDB",
  "track_changes": 1,
  "field_order": [
    "item",
    "public_title",
    "publication_status",
    "short_description",
    "full_description",
    "seo_title",
    "seo_description",
    "gallery",
    "channel_overrides",
    "source_key",
    "source_payload"
  ],
  "fields": [
    {
      "fieldname": "item",
      "label": "Item",
      "fieldtype": "Link",
      "options": "Item",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "public_title",
      "label": "Public Title",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "publication_status",
      "label": "Publication Status",
      "fieldtype": "Select",
      "options": "Draft\nPublished\nRetired",
      "default": "Draft",
      "reqd": 1
    },
    {
      "fieldname": "short_description",
      "label": "Short Description",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "full_description",
      "label": "Full Description",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "seo_title",
      "label": "Seo Title",
      "fieldtype": "Data"
    },
    {
      "fieldname": "seo_description",
      "label": "Seo Description",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "gallery",
      "label": "Gallery",
      "fieldtype": "Table",
      "options": "Commerce Media"
    },
    {
      "fieldname": "channel_overrides",
      "label": "Channel Overrides",
      "fieldtype": "Table",
      "options": "Commerce Channel Override"
    },
    {
      "fieldname": "source_key",
      "label": "Source Key",
      "fieldtype": "Data",
      "unique": 1
    },
    {
      "fieldname": "source_payload",
      "label": "Source Payload",
      "fieldtype": "Code",
      "options": "JSON"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "export": 1
    },
    {
      "role": "Sales Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "export": 1
    },
    {
      "role": "Sales User",
      "read": 1
    }
  ],
  "autoname": "field:item",
  "title_field": "public_title"
}
