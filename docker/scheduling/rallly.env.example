# RootedOps reference for the *separate* upstream Rallly self-hosted .env.
# Copy only these settings into docker/scheduling/rallly-selfhosted/.env,
# which was generated by ./rallly.sh setup. Do NOT replace the generated
# file: it contains required database, object-storage and application secrets.
# See doc/SCHEDULING.md. Never put actual OAuth secrets in Git.
#
DOMAIN=poll.rootedpsyche.org
PROXY_MODE=external
WEB_PORT=127.0.0.1:3003
GOOGLE_CLIENT_ID=replace_with_same_google_web_oauth_client_id_as_tymeslot
GOOGLE_CLIENT_SECRET=replace_with_same_google_web_oauth_client_secret_as_tymeslot
GOOGLE_LOGIN_ENABLED=true
CONFERENCING_PROVIDERS=google-meet
#
# Gmail SMTP credentials are configured independently in upstream Rallly .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rootedpsyche@gmail.com
SMTP_PWD=replace_with_rallly_google_app_password
